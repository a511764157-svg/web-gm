---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import Card from '@components/ui/Card.astro';
import RFQForm from '@components/react/RFQForm';
import { Image } from 'astro:assets';
import { Icon } from 'astro-iconset/components';
import rfqBgImg from '@assets/gb/hero-labeling.jpg';
import { COMPANY, CONTACT } from '@config/site';
import showcaseImg from '@assets/gb/banner-equipment-overview.jpg';

// 与站内其它组件一致的哨兵判断：占位号被换掉之前，不显示 WhatsApp 入口。
const hasWhatsApp = Boolean(CONTACT.whatsapp && CONTACT.whatsapp !== '8613800000000');
const waHref = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(
  'Hello, I would like a proposal for a fire extinguisher production line.'
)}`;
---

<BaseLayout title="Request a Quote - Get Started Today">
  <!-- Hero Section with Professional Image -->
  <section class="relative h-[500px] md:h-[600px] flex items-center overflow-hidden">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0">
      <Image 
        src={rfqBgImg}
        alt=""
        class="w-full h-full object-cover"
        width={2070}
        height={1380}
      />
      <div class="absolute inset-0 bg-linear-to-r from-slate-900/95 via-blue-900/90 to-slate-900/85"></div>
    </div>

    <!-- Content -->
    <div class="container mx-auto relative z-10 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center px-4 py-2 mb-6 bg-linear-to-r from-blue-600 to-teal-600 text-white text-sm font-semibold rounded-full shadow-lg animate-fadeInUp">
          <Icon name="lucide:file-text" class="w-4 h-4 mr-2" />
          Get Your Custom Quote Today
        </div>
        
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight animate-fadeInUp" style="animation-delay: 0.1s">
          Request a <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 via-teal-400 to-blue-400">Quote</span>
        </h1>
        
        <p class="text-xl md:text-2xl text-slate-200 mb-8 max-w-3xl mx-auto leading-relaxed animate-fadeInUp" style="animation-delay: 0.2s">
          Tell us the extinguisher type, cylinder size and target output — we reply with
          equipment selection, pricing and lead time within 24 hours.
        </p>

        <!-- Quick Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 pt-8 border-t border-white/20 animate-fadeInUp" style="animation-delay: 0.3s">
          <div class="group">
            <div class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-linear-to-r from-white to-blue-200 mb-1">24hr</div>
            <div class="text-sm text-slate-300 group-hover:text-teal-300 transition-colors">Response Time</div>
          </div>
          <div class="group">
            <div class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-linear-to-r from-white to-blue-200 mb-1">{COMPANY.countries}</div>
            <div class="text-sm text-slate-300 group-hover:text-teal-300 transition-colors">Countries Served</div>
          </div>
          <div class="group">
            <div class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-linear-to-r from-white to-blue-200 mb-1">{COMPANY.precision}</div>
            <div class="text-sm text-slate-300 group-hover:text-teal-300 transition-colors">Filling Accuracy</div>
          </div>
          <div class="group">
            <div class="text-3xl md:text-4xl font-bold text-transparent bg-clip-text bg-linear-to-r from-white to-blue-200 mb-1">{COMPANY.machines}</div>
            <div class="text-sm text-slate-300 group-hover:text-teal-300 transition-colors">Machines</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Wave separator -->
    <!-- <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
        <path d="M0 120L60 110C120 100 240 80 360 70C480 60 600 60 720 65C840 70 960 80 1080 85C1200 90 1320 90 1380 90L1440 90V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z" fill="white"/>
      </svg>
    </div> -->
  </section>

  <!-- Main Form Section -->
  <Section background="gray">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Form -->
      <div class="lg:col-span-2">
        <Card>
          <RFQForm client:load />
        </Card>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- Contact Info Card -->
        <Card class="bg-linear-to-br from-blue-50 to-teal-50 border-blue-200">
          <div class="flex items-center mb-4">
            <div class="w-10 h-10 rounded-lg bg-linear-to-br from-blue-600 to-teal-600 flex items-center justify-center mr-3">
              <Icon name="lucide:phone" class="w-5 h-5 text-white" />
            </div>
            <h3 class="text-xl font-bold text-gray-900">Need Help?</h3>
          </div>
          <div class="space-y-4 text-sm">
            <div class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <div class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center shrink-0">
                <Icon name="lucide:phone" class="w-5 h-5 text-blue-600" />
              </div>
              <div>
                <a href={`tel:${CONTACT.phone.replace(/[^+\d]/g, '')}`} class="font-semibold text-gray-900 hover:text-blue-700 transition-colors">Phone</a>
                <div class="text-gray-600 font-medium">{CONTACT.phone}</div>
                <div class="text-gray-500 text-xs">Mon–Sat, 08:00–18:00 (GMT+8)</div>
              </div>
            </div>

            <div class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <div class="w-10 h-10 rounded-lg bg-teal-100 flex items-center justify-center shrink-0">
                <Icon name="lucide:mail" class="w-5 h-5 text-teal-600" />
              </div>
              <div>
                <a href={`mailto:${CONTACT.email}`} class="font-semibold text-gray-900 hover:text-teal-700 transition-colors">Email</a>
                <div class="text-gray-600 font-medium break-all">{CONTACT.email}</div>
                <div class="text-gray-500 text-xs">Line proposal within {COMPANY.response}</div>
              </div>
            </div>

            {hasWhatsApp ? (
              <a href={waHref} target="_blank" rel="noopener noreferrer" data-track="whatsapp" class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
                <div class="w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center shrink-0">
                  <Icon name="lucide:message-circle" class="w-5 h-5 text-green-600" />
                </div>
                <div>
                  <div class="font-semibold text-gray-900">WhatsApp</div>
                  <div class="text-gray-600 font-medium">{CONTACT.phone}</div>
                  <div class="text-gray-500 text-xs">Send cylinder sizes and target output</div>
                </div>
              </a>
            ) : (
              <div class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
                <div class="w-10 h-10 rounded-lg bg-green-100 flex items-center justify-center shrink-0">
                  <Icon name="lucide:clock" class="w-5 h-5 text-green-600" />
                </div>
                <div>
                  <div class="font-semibold text-gray-900">Working Hours</div>
                  <div class="text-gray-600 font-medium">Mon–Sat, 08:00–18:00</div>
                  <div class="text-gray-500 text-xs">China Standard Time (GMT+8)</div>
                </div>
              </div>
            )}
          </div>
        </Card>

        <!-- What to Expect Card -->
        <Card class="bg-linear-to-br from-primary-50 via-blue-50 to-secondary-50 border-primary-200">
          <div class="flex items-center mb-4">
            <div class="w-10 h-10 rounded-lg bg-linear-to-br from-primary-600 to-blue-600 flex items-center justify-center mr-3">
              <Icon name="lucide:clock" class="w-5 h-5 text-white" />
            </div>
            <h3 class="text-xl font-bold text-gray-900">What to Expect</h3>
          </div>
          <ol class="space-y-4 text-sm">
            <li class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <span class="shrink-0 w-8 h-8 rounded-full bg-linear-to-br from-blue-600 to-blue-700 text-white flex items-center justify-center font-bold text-sm shadow-md">1</span>
              <div>
                <span class="text-gray-900 font-semibold block">Response</span>
                <span class="text-gray-600">We'll review your request within 24 hours</span>
              </div>
            </li>
            <li class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <span class="shrink-0 w-8 h-8 rounded-full bg-linear-to-br from-teal-600 to-teal-700 text-white flex items-center justify-center font-bold text-sm shadow-md">2</span>
              <div>
                <span class="text-gray-900 font-semibold block">Consultation</span>
                <span class="text-gray-600">Schedule a call to discuss your needs</span>
              </div>
            </li>
            <li class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <span class="shrink-0 w-8 h-8 rounded-full bg-linear-to-br from-green-600 to-green-700 text-white flex items-center justify-center font-bold text-sm shadow-md">3</span>
              <div>
                <span class="text-gray-900 font-semibold block">Proposal</span>
                <span class="text-gray-600">Receive a detailed quote and timeline</span>
              </div>
            </li>
            <li class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <span class="shrink-0 w-8 h-8 rounded-full bg-linear-to-br from-purple-600 to-purple-700 text-white flex items-center justify-center font-bold text-sm shadow-md">4</span>
              <div>
                <span class="text-gray-900 font-semibold block">Partnership</span>
                <span class="text-gray-600">Ongoing production and repeat orders</span>
              </div>
            </li>
          </ol>
        </Card>

        <!-- Trust Indicators -->
        <Card class="bg-linear-to-br from-slate-50 to-gray-50 border-slate-200">
          <div class="flex items-center mb-4">
            <div class="w-10 h-10 rounded-lg bg-linear-to-br from-green-600 to-emerald-600 flex items-center justify-center mr-3">
              <Icon name="lucide:award" class="w-5 h-5 text-white" />
            </div>
            <h3 class="text-xl font-bold text-gray-900">Why Choose Us?</h3>
          </div>
          <ul class="space-y-3 text-sm">
            <li class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <div class="w-8 h-8 rounded-lg bg-green-100 flex items-center justify-center shrink-0">
                <Icon name="lucide:trending-up" class="w-4 h-4 text-green-600" />
              </div>
              <span class="text-gray-700 pt-1">{COMPANY.years} years building filling equipment</span>
            </li>
            <li class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <div class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center shrink-0">
                <Icon name="lucide:circle-check" class="w-4 h-4 text-blue-600" />
              </div>
              <span class="text-gray-700 pt-1">In-house R&amp;D and line manufacturing</span>
            </li>
            <li class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <div class="w-8 h-8 rounded-lg bg-purple-100 flex items-center justify-center shrink-0">
                <Icon name="lucide:shield" class="w-4 h-4 text-purple-600" />
              </div>
              <span class="text-gray-700 pt-1">{COMPANY.patents} patented machine designs</span>
            </li>
            <li class="flex items-start space-x-3 p-3 bg-white rounded-lg hover:shadow-md transition-shadow">
              <div class="w-8 h-8 rounded-lg bg-teal-100 flex items-center justify-center shrink-0">
                <Icon name="lucide:users" class="w-4 h-4 text-teal-600" />
              </div>
              <span class="text-gray-700 pt-1">After-sales support and spare parts</span>
            </li>
          </ul>
        </Card>
      </div>
    </div>
  </Section>

  <!-- Trust & Success Section -->
  <Section background="white">
    <div class="text-center mb-12">
      <div class="inline-block px-4 py-2 mb-4 bg-blue-100 text-blue-800 text-sm font-semibold rounded-full">
        Built for Extinguisher Producers
      </div>
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
        Lines Running in <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-teal-600">{COMPANY.countries.replace('+', '')} Countries</span>
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Extinguisher plants, service workshops and fire equipment distributors rely on us for production lines.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
      <!-- Feature 1 -->
      <Card class="text-center hover:shadow-xl transition-all duration-300">
        <div class="w-16 h-16 rounded-full bg-linear-to-br from-blue-600 to-teal-600 flex items-center justify-center mx-auto mb-4">
          <Icon name="lucide:shield" class="w-8 h-8 text-white" />
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">Test-Run Before Shipment</h3>
        <p class="text-gray-600">
          Every line is assembled and run with your own cylinders, then filmed and documented
          for your approval before it leaves our workshop.
        </p>
      </Card>

      <!-- Feature 2 -->
      <Card class="text-center hover:shadow-xl transition-all duration-300">
        <div class="w-16 h-16 rounded-full bg-linear-to-br from-green-600 to-emerald-600 flex items-center justify-center mx-auto mb-4">
          <Icon name="lucide:trending-up" class="w-8 h-8 text-white" />
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">Output That Grows</h3>
        <p class="text-gray-600">
          Start with a 3-station line and add stations as your order book grows — the frame,
          conveyor and control system are built to take the upgrade.
        </p>
      </Card>

      <!-- Feature 3 -->
      <Card class="text-center hover:shadow-xl transition-all duration-300">
        <div class="w-16 h-16 rounded-full bg-linear-to-br from-purple-600 to-pink-600 flex items-center justify-center mx-auto mb-4">
          <Icon name="lucide:users" class="w-8 h-8 text-white" />
        </div>
        <h3 class="text-xl font-bold text-gray-900 mb-2">Installation & Training</h3>
        <p class="text-gray-600">
          Our engineers commission the line at your plant and train your operators, with
          spare parts and technical support continuing afterwards.
        </p>
      </Card>
    </div>

    <!-- Visual Showcase -->
    <div class="relative rounded-2xl overflow-hidden shadow-2xl">
      <div class="absolute inset-0">
        <Image 
          src={showcaseImg}
          alt=""
          class="w-full h-full object-cover"
          width={2070}
          height={800}
        />
        <div class="absolute inset-0 bg-linear-to-r from-slate-900/90 via-blue-900/80 to-slate-900/70"></div>
      </div>
      <div class="relative z-10 p-12 md:p-16 text-center text-white">
        <h3 class="text-3xl md:text-4xl font-bold mb-4">
          Ready to Plan Your Line?
        </h3>
        <p class="text-xl text-slate-200 mb-8 max-w-2xl mx-auto">
          Send us your cylinder sizes and target output — we reply with equipment selection,
          pricing and lead time within {COMPANY.response}.
        </p>
        <a 
          href="#rfq-form" 
          class="inline-flex items-center px-8 py-4 bg-linear-to-r from-blue-600 to-teal-600 hover:from-blue-700 hover:to-teal-700 text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transition-all duration-200"
        >
          Request Your Quote Now
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </Section>
</BaseLayout>

