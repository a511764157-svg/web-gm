---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import CapabilityAccordion from '../components/react/CapabilityAccordion';
import { Image } from 'astro:assets';
import ImageReveal from '../components/react/ImageReveal';
import { SITE, COMPANY } from '../config/site';

import cncImg from '@assets/photo-1581091226825-a6a2a5aee158.jpg';
import manualImg from '@assets/photo-1558618666-fcd25c85cd64.jpg';
import sheetMetalImg from '@assets/photo-1565043589221-1a6fd9ae45c7.jpg';
import castingImg from '@assets/photo-1518770660439-4636190af475.jpg';
import finishingImg from '@assets/photo-1586528116311-ad8dd3c8310d.jpg';
import qualityImg from '@assets/photo-1551288049-bebda4e38f71.jpg';
import heroBgImg from '@assets/photo-1581091226825-a6a2a5aee158.jpg';
import ctaBgImg from '@assets/photo-1553413077-190dd305871c.jpg';

const capabilities = [
  {
    title: 'Dry Powder Filling Lines',
    description: `Automatic filling lines for dry powder extinguishers — 3, 4 and 8 station configurations covering 1 kg to 8 kg portable units and 25–70 kg wheeled units, with filling accuracy to ${COMPANY.precision}.`,
    icon: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15a3 3 0 100-6 3 3 0 000 6z" />
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v3m0 12v3M5.6 5.6l2.1 2.1m8.6 8.6l2.1 2.1M3 12h3m12 0h3M5.6 18.4l2.1-2.1m8.6-8.6l2.1-2.1" />
    </svg>`,
    image: cncImg,
    features: [
      '8-station lines for 3 / 4 / 5 kg and 2–8 kg units',
      '4-station and 3-station lines for smaller output',
      'Hanging line configuration for high-volume plants',
      'Cart filling machine for 25–70 kg wheeled units',
      'Water-based filling line also available',
    ]
  },
  {
    title: 'Leak Detection & Water Testing',
    description: `Third-generation leak detection systems and full-automatic water testing machines — every cylinder is pressure-tested before it leaves the line.`,
    icon: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a1 1 0 112 0v7h1.5a1 1 0 010 2H13v7a1 1 0 11-2 0v-7H9.5a1 1 0 010-2H11V4z" />
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 20h16" />
    </svg>`,
    image: manualImg,
    features: [
      'Leak detection system (3rd generation)',
      'Full-automatic water testing machine',
      'Electric cylinder leak detector',
      'Pressure testing and leak detection machine',
      'Turning vibration + 2-station automatic inflator',
    ]
  },
  {
    title: 'Labelling & Screen Printing',
    description: 'Drying, labelling and multi-colour screen printing in one continuous pass — cylinders come off the line clean, dry, labelled and printed.',
    icon: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6v12M20 6v12" />
    </svg>`,
    image: sheetMetalImg,
    features: [
      'Drying & labelling all-in-one machine',
      'Multi-head labelling machine',
      'Monochrome drying & printing all-in-one',
      'Multifunctional multi-colour screen printing',
      'Single monochrome screen printing machine',
    ]
  },
  {
    title: 'Cylinder Welding & Handling',
    description: 'Bottle welding equipment plus the transfer and handling mechanisms that keep cylinders moving between stations without manual handling.',
    icon: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
    </svg>`,
    image: castingImg,
    features: [
      'Bottle welding equipment',
      'Turnover transfer device',
      'Horizontal to vertical adjustment mechanism',
      'Rotary table tube screwing machine',
      'Head loosening and head installation stations',
    ]
  },
  {
    title: 'Service & Maintenance Equipment',
    description: 'For workshops that recharge and service extinguishers rather than build them — powder extraction, refilling, inflation, drying and gauge testing.',
    icon: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3s6 6.5 6 10.5a6 6 0 11-12 0C6 9.5 12 3 12 3z" />
    </svg>`,
    image: finishingImg,
    features: [
      'Maintenance & inflation integrated equipment',
      'Multifunctional and vehicle-mounted maintenance machines',
      'Powder extraction & filling, dry powder recovery',
      'CO₂ and water-based extinguisher service machines',
      'Cylinder dryer, pressure gauge tester, head disassembly',
    ]
  },
  {
    title: 'Turnkey Line Engineering',
    description: `Our roadmap is one line for everything: steel plate → cylinder → painting → filling → inflation → water testing → printing → cartoning → sealing → warehousing. We engineer and build the whole chain.`,
    icon: `<svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
    </svg>`,
    image: qualityImg,
    features: [
      `${COMPANY.patents} patents, 3 of them invention patents`,
      'In-house automation and intelligent design team',
      'Line layout designed around your floor space',
      'Installation, commissioning and operator training',
      'Lifetime technical support and spare parts',
    ]
  }
];

// ---- 产品型号清单（B2B 买家看型号判断真实能力）----
const equipment = [
  { name: '8-Station Automatic Filling Line', spec: 'Dry powder, 3 / 4 / 5 kg', qty: 'Series' },
  { name: '8-Station Automatic Filling Machine', spec: 'Dry powder, 2–8 kg', qty: 'Series' },
  { name: 'Four-station Dry Powder Filling Line', spec: 'High-efficiency automated line', qty: 'Series' },
  { name: '3-Station Dry Powder Filling Machine', spec: 'Compact plants', qty: 'Series' },
  { name: 'Hanging Fire Extinguisher Production Line', spec: 'High-volume continuous', qty: 'Series' },
  { name: 'Cart Filling Machine', spec: '25–70 kg wheeled units', qty: 'Series' },
  { name: 'Leak Detection System', spec: '3rd generation', qty: 'Series' },
  { name: 'Full-automatic Water Testing Machine', spec: 'Pressure & leak test', qty: 'Series' },
  { name: 'Drying & Labelling All-in-One Machine', spec: 'Dust removal, drying, labelling', qty: 'Series' },
  { name: 'Multi-Colour Screen Printing Machine', spec: 'Fully automatic', qty: 'Series' },
  { name: 'Maintenance & Inflation Integrated Equipment', spec: 'Portable & wheeled units', qty: 'Series' },
  { name: 'CO₂ / Water-Based Service Machines', spec: 'Recharge & test', qty: 'Series' }
];

const processSteps = [
  {
    step: '01',
    title: 'Tell Us Your Target',
    description: 'Which extinguisher types, what cylinder sizes, and how many units per shift. A photo of your workshop or a simple layout sketch is enough to start.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
    </svg>`
  },
  {
    step: '02',
    title: 'Line Proposal & Layout',
    description: `Equipment selection, line layout and floor-space plan for your plant. Proposal and price sent within ${COMPANY.response}.`,
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
    </svg>`
  },
  {
    step: '03',
    title: 'Build & Test Run',
    description: 'Machines are assembled and run with your cylinder size before shipment. You receive test-run video and acceptance photos.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
    </svg>`
  },
  {
    step: '04',
    title: 'Install & Train',
    description: 'Installation, commissioning and operator training at your plant, then lifetime technical support and spare parts supply.',
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>`
  }
];
---

<BaseLayout title={`Fire Extinguisher Equipment - ${SITE.title}`}>
  <!-- Hero Section -->
  <section class="relative h-[70vh] min-h-[500px] flex items-center overflow-hidden">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0">
      <Image
        src={heroBgImg}
        alt="Fire extinguisher production equipment workshop"
        class="w-full h-full object-cover"
        width={2070}
        height={1380}
      />
      <div class="absolute inset-0 bg-linear-to-r from-slate-900/95 via-slate-900/80 to-slate-900/50"></div>
    </div>

    <!-- Content -->
    <div class="container mx-auto relative z-10 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center px-4 py-2 mb-6 bg-linear-to-r from-blue-600 to-teal-600 text-white text-sm font-semibold rounded-full shadow-lg">
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
          </svg>
          {COMPANY.patents} Patents · Since {COMPANY.founded}
        </div>

        <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight">
          Production <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 via-teal-400 to-blue-400">
            Equipment
          </span>
        </h1>

        <p class="text-xl md:text-2xl text-slate-200 mb-8 max-w-3xl mx-auto leading-relaxed">
          Dry powder filling lines, leak testing, labelling and printing — plus everything
          a service workshop needs. Engineered in-house since {COMPANY.founded}.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Capabilities -->
  <Section background="gray">
    <!-- Accordion View for Mobile/Compact -->
    <div class="lg:hidden mb-12">
      <CapabilityAccordion capabilities={capabilities} client:load />
    </div>

    <!-- Grid View for Desktop -->
    <div class="hidden lg:block space-y-24">
      {capabilities.map((capability, index) => (
        <div class={`grid grid-cols-1 lg:grid-cols-2 gap-12 items-center ${index % 2 === 1 ? 'lg:grid-flow-dense' : ''}`}>
          <div class={`${index % 2 === 1 ? 'lg:col-start-2' : ''} animate-fadeInUp`}>
            <div class="flex items-center justify-center w-16 h-16 rounded-xl bg-linear-to-br from-blue-500 to-teal-500 text-white mb-6 shadow-lg">
              <div class="w-8 h-8" set:html={capability.icon.replace('w-12 h-12', 'w-8 h-8').replace('currentColor', 'white')} />
            </div>
            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
              {capability.title}
            </h2>
            <p class="text-lg text-gray-600 mb-6 leading-relaxed">
              {capability.description}
            </p>
            <ul class="space-y-3">
              {capability.features.map((feature) => (
                <li class="flex items-center space-x-3">
                  <svg class="w-5 h-5 text-teal-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                  <span class="text-gray-700">{feature}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class={`${index % 2 === 1 ? 'lg:col-start-1 lg:row-start-1' : ''}`}>
            <ImageReveal client:load delay={index * 0.1}>
              <div class="relative aspect-4/3 group overflow-hidden rounded-2xl shadow-2xl">
                <Image
                  src={capability.image}
                  alt={capability.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  width={1200}
                  height={800}
                />
                <div class="absolute inset-0 bg-linear-to-t from-slate-900/60 via-transparent to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
                  <h3 class="text-2xl font-bold mb-2">{capability.title}</h3>
                  <p class="text-gray-200">{capability.description}</p>
                </div>
              </div>
            </ImageReveal>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- Equipment List -->
  <Section background="white">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 bg-teal-100 text-teal-800 text-sm font-semibold rounded-full">
        Machine Range
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        Our <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-teal-600">Equipment</span>
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
        {COMPANY.machines} machine models across a {COMPANY.area} workshop — production lines
        and service equipment, most of them covered by our own patents.
      </p>
    </div>

    <div class="max-w-5xl mx-auto overflow-hidden rounded-2xl border border-slate-200 shadow-sm">
      <table class="w-full text-left">
        <thead class="bg-slate-900 text-white">
          <tr>
            <th class="px-6 py-4 text-sm font-semibold uppercase tracking-wider">Equipment</th>
            <th class="px-6 py-4 text-sm font-semibold uppercase tracking-wider">Application</th>
            <th class="px-6 py-4 text-sm font-semibold uppercase tracking-wider text-right">Range</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white">
          {equipment.map((item) => (
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-6 py-4 font-medium text-gray-900">{item.name}</td>
              <td class="px-6 py-4 text-gray-600">{item.spec}</td>
              <td class="px-6 py-4 text-gray-900 font-semibold text-right">{item.qty}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="text-center text-sm text-gray-500 mt-6">
      Machine range shown for reference. Full specifications available on request.
    </p>
  </Section>

  <!-- Process Section -->
  <Section background="gray">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 bg-blue-100 text-blue-800 text-sm font-semibold rounded-full">
        How We Work
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
        From Enquiry to <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-teal-600">Running Line</span>
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
        A straightforward four-step process — no middlemen, no surprises.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {processSteps.map((process, index) => (
        <Card hover class="text-center animate-fadeInUp group" style={`animation-delay: ${index * 0.1}s`}>
          <div class="flex items-center justify-center w-16 h-16 mx-auto mb-4 rounded-xl bg-linear-to-br from-blue-500 to-teal-500 text-white shadow-lg group-hover:scale-110 transition-transform">
            <div set:html={process.icon} />
          </div>
          <div class="text-3xl font-bold text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-teal-600 mb-2">{process.step}</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">{process.title}</h3>
          <p class="text-gray-600 leading-relaxed">{process.description}</p>
        </Card>
      ))}
    </div>
  </Section>

  <!-- CTA Section -->
  <section class="relative py-32 overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0">
      <Image
        src={ctaBgImg}
        alt="Equipment assembly workshop"
        class="w-full h-full object-cover"
        width={2070}
        height={1380}
      />
      <div class="absolute inset-0 bg-linear-to-r from-blue-900/95 to-teal-900/95"></div>
    </div>

    <!-- Content -->
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center text-white">
        <div class="inline-block px-4 py-2 mb-6 bg-white/10 backdrop-blur-sm text-white text-sm font-semibold rounded-full">
          Get Started Today
        </div>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
          Tell Us Your Output, <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 to-teal-400">Get a Line Plan</span>
        </h2>
        <p class="text-xl md:text-2xl text-slate-200 mb-12 max-w-2xl mx-auto leading-relaxed">
          Tell us the extinguisher type, cylinder size and target output — our engineers reply
          with equipment selection and pricing within {COMPANY.response}.
        </p>

        <div class="flex flex-col sm:flex-row gap-6 justify-center">
          <Button href="/rfq" size="lg" class="bg-blue-600! hover:bg-blue-700! text-white! shadow-2xl!">
          Request a Quote
        </Button>
          <Button href="/" size="lg" variant="outline" class="border-2! border-white! text-white! hover:bg-white/10! shadow-2xl!">
          Back to Home
        </Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
