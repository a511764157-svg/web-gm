---
// 全站常驻的悬浮联系按钮
// 社交流量下这是主要承接入口，也是 Pixel 转化事件来源
import { CONTACT } from '@config/site';

const waMsg = encodeURIComponent(
  'Hello, I found your website and I am interested in your products. Could you send me more information?'
);
const waUrl = `https://wa.me/${CONTACT.whatsapp}?text=${waMsg}`;
const tgUrl = CONTACT.telegram ? `https://t.me/${CONTACT.telegram}` : '';
const showWa = Boolean(CONTACT.whatsapp && CONTACT.whatsapp !== '8613800000000');
const showTg = Boolean(tgUrl);
---

{
  (showWa || showTg) && (
    <div class="fixed bottom-5 right-5 z-[60] flex flex-col items-end gap-3">
      {showTg && (
        <a
          href={tgUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-track="telegram"
          aria-label="Chat on Telegram"
          class="float-contact group flex h-12 w-12 items-center justify-center rounded-full bg-[#229ED9] text-white shadow-lg transition-transform hover:scale-110"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6" aria-hidden="true">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.005-.03.01-.14-.052-.198-.062-.058-.154-.038-.22-.023-.093.021-1.582 1.006-4.463 2.95-.422.29-.802.432-1.14.425-.375-.007-1.096-.212-1.632-.387-.657-.214-1.178-.327-1.157-.69.011-.19.28-.385.824-.584 3.216-1.4 5.358-2.325 6.427-2.775 3.046-1.286 3.678-1.509 4.088-1.516z" />
          </svg>
        </a>
      )}

      {showWa && (
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-track="whatsapp"
          aria-label="Chat on WhatsApp"
          class="float-contact group flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-xl transition-transform hover:scale-110"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-8 w-8" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 0 1 6.988 2.896 9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
          </svg>
        </a>
      )}
    </div>
  )
}

<script>
  // 点击时上报转化事件，让 GTM / Meta Pixel 知道这是一次有效转化
  const w = window as unknown as {
    dataLayer?: Record<string, unknown>[];
    fbq?: (...args: unknown[]) => void;
  };

  document.querySelectorAll('.float-contact').forEach((el) => {
    el.addEventListener('click', () => {
      const channel = el.getAttribute('data-track') || 'contact';
      w.dataLayer = w.dataLayer || [];
      w.dataLayer.push({ event: 'contact_click', channel });
      if (typeof w.fbq === 'function') w.fbq('track', 'Contact');
    });
  });
</script>
