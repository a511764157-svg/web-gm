---
import ImageReveal from '@components/react/ImageReveal';
import { Image } from 'astro:assets';
import workshopImg from '@assets/photo-1566576721346-d4a3b4eaeb55.jpg';
import machiningImg from '@assets/photo-1581091226825-a6a2a5aee158.jpg';
import turningImg from '@assets/photo-1558618666-fcd25c85cd64.jpg';
import inspectionImg from '@assets/photo-1551288049-bebda4e38f71.jpg';
import dispatchImg from '@assets/photo-1586528116311-ad8dd3c8310d.jpg';
---

<section class="py-24 bg-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 bg-teal-100 text-teal-800 text-sm font-semibold rounded-full">
        Inside Our Factory
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-slate-900 mb-6">
        Real <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-600 to-teal-600">Production Floor</span>
      </h2>
      <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Machining centres, inspection equipment and assembly lines — the facility your parts
        will actually be made in.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Large featured image -->
      <div class="md:row-span-2">
        <ImageReveal client:load delay={0}>
          <div class="relative h-full group overflow-hidden rounded-2xl shadow-xl">
            <Image 
              src={workshopImg}
              alt="Machining workshop floor"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              width={1200}
              height={800}
            />
            <div class="absolute inset-0 bg-linear-to-t from-slate-900/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
              <h3 class="text-2xl font-bold mb-2">Machining Workshop</h3>
              <p class="text-gray-200">Machining centres, turning cells and inspection equipment on one floor</p>
            </div>
          </div>
        </ImageReveal>
      </div>

      <ImageReveal client:load delay={0.1}>
        <div class="relative h-64 lg:h-auto group overflow-hidden rounded-2xl shadow-xl">
            <Image 
              src={turningImg}
              alt="CNC turning and milling equipment"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              width={800}
              height={600}
            />
            <div class="absolute inset-0 bg-linear-to-t from-slate-900/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <h3 class="text-xl font-bold mb-1">Turning & Milling</h3>
              <p class="text-sm text-gray-200">Tolerances held to ±0.01 mm on critical dimensions</p>
            </div>
        </div>
      </ImageReveal>

      <ImageReveal client:load delay={0.2}>
        <div class="relative h-64 lg:h-auto group overflow-hidden rounded-2xl shadow-xl">
            <Image 
              src={machiningImg}
              alt="Machinist setting up a machining job"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              width={800}
              height={600}
            />
            <div class="absolute inset-0 bg-linear-to-t from-slate-900/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <h3 class="text-xl font-bold mb-1">Skilled Operators</h3>
              <p class="text-sm text-gray-200">Engineers who read your drawings, not just run the machines</p>
            </div>
        </div>
      </ImageReveal>

      <div class="lg:row-start-3">        
        <ImageReveal client:load delay={0.3}>
          <div class="lg:col-span-2 relative h-64 lg:h-auto group overflow-hidden rounded-2xl shadow-xl">
            <Image 
              src={inspectionImg}
              alt="Dimensional inspection and measurement"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              width={1200}
              height={600}
            />
            <div class="absolute inset-0 bg-linear-to-t from-slate-900/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <h3 class="text-xl font-bold mb-1">Inspection & Reporting</h3>
              <p class="text-sm text-gray-200">Dimensional checks documented before every shipment</p>
            </div>
          </div>
        </ImageReveal>
      </div>
      <div class="lg:row-start-2 lg:col-start-2 lg:row-span-2 lg:col-span-2">        
        <ImageReveal client:load delay={0.4}>
          <div class="relative h-64 lg:h-auto group overflow-hidden rounded-2xl shadow-xl">
            <Image 
              src={dispatchImg}
              alt="Packed parts ready for dispatch"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              width={800}
              height={600}
            />
            <div class="absolute inset-0 bg-linear-to-t from-slate-900/80 via-transparent to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-6 text-white">
              <h3 class="text-xl font-bold mb-1">Packing & Dispatch</h3>
              <p class="text-sm text-gray-200">Export packing for sea or air freight, booked to your forwarder</p>
            </div>
          </div>
        </ImageReveal>
      </div>
    </div>
    
    <!-- Bottom CTA -->
    <div class="text-center mt-16">
      <a 
        href="/capabilities"
        class="inline-flex items-center px-8 py-4 text-base font-semibold text-white bg-linear-to-r from-teal-600 to-teal-700 hover:from-teal-700 hover:to-teal-800 rounded-lg shadow-lg hover:shadow-xl transition-all group"
      >
        See Our Capabilities
        <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

