---
import { Image } from 'astro:assets';
import AnimatedStats from '../react/AnimatedStats';
import { EXPORT_MARKETS } from '@config/site';
import sectionBgImg from '@assets/photo-1578575437130-527eed3abbec.jpg';
---

<section class="relative py-24 overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0">
    <!-- 纯装饰性背景图，用空 alt，避免给无意义的描述 -->
    <Image 
      src={sectionBgImg}
      alt=""
      class="w-full h-full object-cover"
      width={2070}
      height={1380}
    />
    <div class="absolute inset-0 bg-slate-900/90"></div>
  </div>

  <!-- Content -->
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 bg-white/10 backdrop-blur-sm text-white text-sm font-semibold rounded-full">
        Performance Metrics
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-6">
        Numbers <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 to-teal-400">Buyers Check</span>
      </h2>
      <p class="text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed">
        Every figure below is verifiable — from machining tolerance to export coverage.
      </p>
    </div>

    <AnimatedStats client:load />

    <!-- Export Markets（原来这里是 4 个空 CLIENT 占位块，空占位反而显得可疑） -->
    <div class="mt-20">
      <p class="text-center text-slate-400 text-sm font-semibold uppercase tracking-wider mb-8">
        Exporting to {EXPORT_MARKETS.length} Markets Worldwide
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        {EXPORT_MARKETS.map((market) => (
          <span class="px-5 py-2.5 bg-white/5 backdrop-blur-sm rounded-lg text-slate-200 text-sm font-medium border border-white/10 hover:border-teal-400/50 hover:text-white transition-all">
            {market}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

