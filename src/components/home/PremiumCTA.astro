---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import warehouseBgImg from '@assets/photo-1553413077-190dd305871c.jpg';
import { CONTACT, COMPANY } from '@config/site';

const waHref = `https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent('Hello, I would like to request a quote.')}`;
const hasWhatsApp = Boolean(CONTACT.whatsapp && CONTACT.whatsapp !== '8613800000000');
---

<section class="relative py-32 overflow-hidden">
  <!-- Background Image -->
  <div class="absolute inset-0">
    <Image 
      src={warehouseBgImg}
      alt="Modern warehouse operations"
      class="w-full h-full object-cover"
      width={2070}
      height={1380}
    />
    <div class="absolute inset-0 bg-linear-to-r from-blue-900/95 to-teal-900/95"></div>
  </div>

  <!-- Content -->
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="max-w-4xl mx-auto text-center text-white">
      <div class="inline-block px-4 py-2 mb-6 bg-white/10 backdrop-blur-sm text-white text-sm font-semibold rounded-full">
        Get Started Today
      </div>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
        Ready to Build Your <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 to-teal-400">Custom Parts</span>?
      </h2>
      <p class="text-xl md:text-2xl text-slate-200 mb-12 max-w-2xl mx-auto leading-relaxed">
        Send your drawings — our engineers reply within {COMPANY.response} with DFM feedback and a quotation.
      </p>

      <div class="flex flex-col sm:flex-row gap-6 justify-center mb-16">
        <a
          href="/rfq"
          class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-blue-900 bg-white hover:bg-slate-100 rounded-lg shadow-2xl hover:shadow-3xl transition-all group"
        >
          Get a Free Quote
          <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        {
          hasWhatsApp ? (
            <a
              href={waHref}
              target="_blank"
              rel="noopener noreferrer"
              data-track="whatsapp"
              class="float-contact inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white bg-[#25D366] hover:brightness-95 rounded-lg shadow-2xl transition-all group"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 mr-2" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 0 1 6.988 2.896 9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
              </svg>
              WhatsApp Us
            </a>
          ) : (
            <a
              href="/facilities"
              class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold text-white border-2 border-white hover:bg-white/10 rounded-lg shadow-2xl hover:shadow-3xl transition-all group"
            >
              Tour Our Facilities
              <svg class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          )
        }
      </div>

      <!-- Trust indicators -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
        <div class="backdrop-blur-sm bg-white/10 rounded-xl p-6 hover:bg-white/20 transition-all border border-white/10 hover:border-white/30 group">
          <div class="text-3xl md:text-4xl font-bold mb-2 text-transparent bg-clip-text bg-linear-to-r from-white to-blue-200">25+</div>
          <div class="text-sm text-slate-300 group-hover:text-teal-300 transition-colors">Years Experience</div>
        </div>
        <div class="backdrop-blur-sm bg-white/10 rounded-xl p-6 hover:bg-white/20 transition-all border border-white/10 hover:border-white/30 group">
          <div class="text-3xl md:text-4xl font-bold mb-2 text-transparent bg-clip-text bg-linear-to-r from-white to-blue-200">ISO 9001</div>
          <div class="text-sm text-slate-300 group-hover:text-teal-300 transition-colors">Certified</div>
        </div>
        <div class="backdrop-blur-sm bg-white/10 rounded-xl p-6 hover:bg-white/20 transition-all border border-white/10 hover:border-white/30 group">
          <div class="text-3xl md:text-4xl font-bold mb-2 text-transparent bg-clip-text bg-linear-to-r from-white to-blue-200">24/7</div>
          <div class="text-sm text-slate-300 group-hover:text-teal-300 transition-colors">Support</div>
        </div>
        <div class="backdrop-blur-sm bg-white/10 rounded-xl p-6 hover:bg-white/20 transition-all border border-white/10 hover:border-white/30 group">
          <div class="text-3xl md:text-4xl font-bold mb-2 text-transparent bg-clip-text bg-linear-to-r from-white to-blue-200">Global</div>
          <div class="text-sm text-slate-300 group-hover:text-teal-300 transition-colors">Network</div>
        </div>
      </div>
    </div>
  </div>
</section>

