---
// 认证版块：B2B 信任的核心要素之一
// 真实机械厂外贸站普遍会把认证放在显著位置
import { Icon } from 'astro-iconset/components';
import { CERTIFICATIONS } from '@config/site';
---

<section class="border-y border-slate-200 bg-slate-50 py-14">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <p class="mb-8 text-center text-sm font-semibold uppercase tracking-wider text-slate-500">
      Why Greenbo
    </p>

    <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
      {
        CERTIFICATIONS.map((cert) => (
          <div class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-all hover:border-teal-300 hover:shadow-md">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-teal-50 text-teal-600">
              <Icon name="lucide:badge-check" class="h-5 w-5" />
            </div>
            <div class="min-w-0">
              <p class="truncate font-semibold text-slate-900">{cert.name}</p>
              <p class="mt-0.5 text-xs leading-snug text-slate-500">{cert.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
